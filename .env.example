# ─────────────────────────────────────────────────────────────
# Breakroom — environment configuration
# Copy this file to .env (local dev) and fill in real values.
# Never commit your real .env file.
# ─────────────────────────────────────────────────────────────

# --- App -------------------------------------------------------
# Public URL of the deployment. Used for building absolute links
# (emails, OAuth redirects, etc).
APP_URL=http://localhost:3000

# Long random string used to sign/hash session tokens.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=replace-with-a-long-random-string

# --- Workspace subdomains (optional) -------------------------------
# If you point a wildcard DNS record (e.g. "*.yourdomain.com") at this
# deployment, visiting "acme.yourdomain.com" transparently serves the
# "acme" workspace (same app, no separate deploy). Requires APP_URL
# above to be set to your real root domain for the subdomain to be
# recognized. Set COOKIE_DOMAIN to a leading-dot domain so a single
# login carries across workspace subdomains; leave both blank for a
# purely path-based deployment (default).
COOKIE_DOMAIN=

# --- Database ----------------------------------------------------
# Local development (default): a file-based SQLite database.
#   DATABASE_URL=file:./sqlite.db
#
# Vercel / other Node hosting: point at a Turso (libSQL) database
# so data persists across serverless invocations.
#   DATABASE_URL=libsql://your-db-name.turso.io
#   DATABASE_AUTH_TOKEN=your-turso-auth-token
#
# Cloudflare Workers/Pages: DATABASE_URL is not used. Instead bind
# a D1 database named "DB" in wrangler.toml — see README for details.
DATABASE_URL=file:./sqlite.db
DATABASE_AUTH_TOKEN=

# --- Image uploads (Cloudinary) -----------------------------------
# Create a free account at https://cloudinary.com and grab these
# from your dashboard. Required for image uploads to work.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Discord OAuth (optional, can also be configured per-workspace
# from the Admin panel; these act as instance-wide defaults) --------
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback

# --- Transactional email (optional) ---------------------------------
# Password-reset and invite emails are logged to the console until you
# set RESEND_API_KEY (create a free account at https://resend.com and
# verify a sending domain). EMAIL_FROM must be an address on a domain
# you've verified there, e.g. "Breakroom <noreply@yourdomain.com>" —
# it falls back to Resend's shared onboarding@resend.dev address
# (works, but only deliverable to your own Resend account email).
RESEND_API_KEY=
EMAIL_FROM=

# --- Rate limiting (optional) ---------------------------------------
# By default Breakroom rate-limits using in-memory storage, which is
# fine for a single instance. For multi-instance deployments, wire up
# a shared store (e.g. Upstash Redis) by setting these.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
